// Prisma schema for the Courier Management & Shipment Tracking system.
// Database: PostgreSQL (Supabase).
//
// This schema is normalized to Third Normal Form (3NF):
// - All tables have a single primary key.
// - No transitive dependencies between non-key attributes.
// - Each role-specific extension is a separate table linked 1:1 to users.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  DISPATCHER
  DRIVER
  CUSTOMER
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
}

enum ServiceType {
  STANDARD
  EXPRESS
  SAME_DAY
  OVERNIGHT
  FREIGHT
}

enum TrackingEventType {
  CREATED
  PICKED_UP
  DEPARTED
  IN_TRANSIT
  ARRIVED
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  LOCATION_UPDATE
}

enum NotificationType {
  SHIPMENT_UPDATE
  DELIVERY_ALERT
  PAYMENT_CONFIRMATION
  SYSTEM_MESSAGE
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  CASH
  WALLET
}

enum VehicleType {
  VAN
  TRUCK
  MOTORCYCLE
  BIKE
  DRONE
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum AgentStatus {
  AVAILABLE
  ON_ROUTE
  ON_BREAK
  OFF_DUTY
}

// ── 1. Users ───────────────────────────────────────────────────────────────

model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  password   String
  name       String
  role       UserRole @default(CUSTOMER)
  phone      String?
  avatarUrl  String?  @map("avatar_url")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Role-specific extensions (1:1)
  customer      Customer?
  admin          Admin?
  deliveryAgent  DeliveryAgent?

  // Relations
  shipments           Shipment[]          @relation("CustomerShipments")
  trackingLogs        TrackingHistory[]
  notifications       Notification[]
  payments            Payment[]
  managedBranches     Branch[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ── 2. Customers ───────────────────────────────────────────────────────────

model Customer {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  companyName     String?  @map("company_name")
  companyReg      String?  @map("company_reg")
  billingAddress  String?  @map("billing_address")
  defaultAddress  String?  @map("default_address")
  creditLimit     Decimal  @default(0) @map("credit_limit") @db.Decimal(12, 2)
  totalShipments  Int      @default(0) @map("total_shipments")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("customers")
}

// ── 3. Admins ──────────────────────────────────────────────────────────────

model Admin {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  department    String?
  accessLevel   Int      @default(1) @map("access_level")
  permissions   String[] @default([])
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admins")
}

// ── 4. Delivery Agents ─────────────────────────────────────────────────────

model DeliveryAgent {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @unique @map("user_id") @db.Uuid
  licenseNumber     String?     @map("license_number")
  licenseExpiry     DateTime?   @map("license_expiry") @db.Date
  vehicleId         String?     @map("vehicle_id") @db.Uuid
  status            AgentStatus @default(OFF_DUTY)
  rating            Decimal     @default(0) @db.Decimal(3, 2)
  totalDeliveries   Int         @default(0) @map("total_deliveries")
  currentLatitude   Float?      @map("current_latitude")
  currentLongitude  Float?      @map("current_longitude")
  branchId          String?     @map("branch_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?  @relation("AgentVehicle")
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  assignedShipments Shipment[] @relation("AgentShipments")

  @@index([userId])
  @@index([status])
  @@index([branchId])
  @@index([vehicleId])
  @@map("delivery_agents")
}

// ── 5. Warehouses ──────────────────────────────────────────────────────────

model Warehouse {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  address     String
  city        String
  state       String
  postalCode  String   @map("postal_code")
  country     String   @default("USA")
  latitude    Float?
  longitude   Float?
  capacity    Int      @default(1000)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  branches      Branch[]
  vehiclesHere  Vehicle[]  @relation("VehicleWarehouse")

  @@index([code])
  @@index([city])
  @@map("warehouses")
}

// ── 6. Branches ────────────────────────────────────────────────────────────

model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  code         String   @unique
  address      String
  city         String
  state        String
  postalCode   String   @map("postal_code")
  phone        String?
  email        String?
  warehouseId  String   @map("warehouse_id") @db.Uuid
  managerId    String?   @map("manager_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  manager       User?         @relation(fields: [managerId], references: [id], onDelete: SetNull)
  vehicles      Vehicle[]
  agents        DeliveryAgent[]
  originShipments       Shipment[] @relation("OriginBranch")
  destinationShipments  Shipment[] @relation("DestinationBranch")

  @@index([warehouseId])
  @@index([managerId])
  @@index([code])
  @@map("branches")
}

// ── 7. Vehicles ───────────────────────────────────────────────────────────

model Vehicle {
  id                  String        @id @default(uuid()) @db.Uuid
  registration        String        @unique
  type                VehicleType   @default(VAN)
  model               String?
  capacityWeight      Decimal       @default(1000) @map("capacity_weight") @db.Decimal(10, 2)
  capacityVolume      Decimal?      @map("capacity_volume") @db.Decimal(10, 2)
  status              VehicleStatus @default(ACTIVE)
  branchId            String        @map("branch_id") @db.Uuid
  driverId            String?       @unique @map("driver_id") @db.Uuid
  currentWarehouseId  String?       @map("current_warehouse_id") @db.Uuid
  lastServiceAt       DateTime?     @map("last_service_at") @db.Date
  nextServiceAt       DateTime?     @map("next_service_at") @db.Date
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  branch     Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  driver     DeliveryAgent?  @relation("AgentVehicle", fields: [driverId], references: [id], onDelete: SetNull)
  warehouse  Warehouse?      @relation("VehicleWarehouse", fields: [currentWarehouseId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([driverId])
  @@index([status])
  @@index([registration])
  @@map("vehicles")
}

// ── 8. Shipments ───────────────────────────────────────────────────────────

model Shipment {
  id                    String         @id @default(uuid()) @db.Uuid
  trackingNumber        String         @unique @map("tracking_number")
  status                ShipmentStatus @default(PENDING)
  serviceType           ServiceType    @default(STANDARD) @map("service_type")

  // Sender
  senderName            String         @map("sender_name")
  senderPhone           String         @map("sender_phone")
  senderAddress         String         @map("sender_address")
  senderCity             String         @map("sender_city")
  senderState           String         @map("sender_state")
  senderPostalCode      String         @map("sender_postal_code")
  senderLatitude        Float?         @map("sender_latitude")
  senderLongitude       Float?         @map("sender_longitude")

  // Recipient
  recipientName         String         @map("recipient_name")
  recipientPhone        String         @map("recipient_phone")
  recipientAddress      String         @map("recipient_address")
  recipientCity         String         @map("recipient_city")
  recipientState        String         @map("recipient_state")
  recipientPostalCode   String         @map("recipient_postal_code")
  recipientLatitude     Float?         @map("recipient_latitude")
  recipientLongitude    Float?         @map("recipient_longitude")

  // Package
  weight                Decimal        @db.Decimal(10, 2)
  dimensions            String?
  declaredValue         Decimal?       @default(0) @map("declared_value") @db.Decimal(12, 2)
  notes                 String?

  // Delivery
  estimatedDelivery     DateTime?     @map("estimated_delivery")
  actualDelivery        DateTime?     @map("actual_delivery")
  currentLatitude       Float?         @map("current_latitude")
  currentLongitude      Float?         @map("current_longitude")

  // Relationships
  customerId            String?        @map("customer_id") @db.Uuid
  assignedAgentId       String?        @map("assigned_agent_id") @db.Uuid
  originBranchId        String?        @map("origin_branch_id") @db.Uuid
  destinationBranchId   String?        @map("destination_branch_id") @db.Uuid

  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  customer             User?           @relation("CustomerShipments", fields: [customerId], references: [id], onDelete: SetNull)
  assignedAgent        DeliveryAgent?  @relation("AgentShipments", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  originBranch         Branch?         @relation("OriginBranch", fields: [originBranchId], references: [id], onDelete: SetNull)
  destinationBranch    Branch?         @relation("DestinationBranch", fields: [destinationBranchId], references: [id], onDelete: SetNull)

  trackingHistory  TrackingHistory[]
  notifications    Notification[]
  payments         Payment[]

  @@index([trackingNumber])
  @@index([customerId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([originBranchId])
  @@index([destinationBranchId])
  @@index([createdAt])
  @@map("shipments")
}

// ── 9. Tracking History ────────────────────────────────────────────────────

model TrackingHistory {
  id          String              @id @default(uuid()) @db.Uuid
  shipmentId  String              @map("shipment_id") @db.Uuid
  eventType   TrackingEventType   @map("event_type")
  message     String
  latitude    Float?
  longitude   Float?
  city        String?
  recordedBy  String?              @map("recorded_by") @db.Uuid
  timestamp   DateTime            @default(now())

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  recordedByUser User? @relation(fields: [recordedBy], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([timestamp])
  @@index([eventType])
  @@map("tracking_history")
}

// ── 10. Notifications ──────────────────────────────────────────────────────

model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  shipmentId  String?            @map("shipment_id") @db.Uuid
  type        NotificationType   @default(SHIPMENT_UPDATE)
  status      NotificationStatus @default(UNREAD)
  title       String
  message     String
  createdAt   DateTime           @default(now()) @map("created_at")
  readAt      DateTime?          @map("read_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipment  Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shipmentId])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

// ── 11. Payments ──────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  shipmentId      String        @map("shipment_id") @db.Uuid
  customerId      String?       @map("customer_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  method          PaymentMethod @default(CREDIT_CARD)
  status          PaymentStatus @default(PENDING)
  transactionRef  String?      @map("transaction_ref")
  paymentDate     DateTime?    @map("payment_date")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  shipment  Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  customer  User?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([customerId])
  @@index([status])
  @@index([method])
  @@map("payments")
}

// ── 13. Password Reset Tokens ──────────────────────────────────────────────

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ── 12. Audit Logs ─────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?   @map("entity_id") @db.Uuid
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
